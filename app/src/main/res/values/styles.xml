<resources>
 <style name="Theme.Atlas" parent="android:style/Theme.Material.Light.NoActionBar">
  <item name="android:fontFamily">sans</item><item name="android:windowLightStatusBar">false</item>
  <item name="android:colorAccent">#FFA18D</item><item name="android:navigationBarColor">#0B0E19</item>
  <item name="android:windowActionModeOverlay">true</item>
 </style>
 <style name="Theme.Atlas.Starting" parent="Theme.SplashScreen">
  <item name="windowSplashScreenBackground">@color/icon_background</item>
  <item name="windowSplashScreenAnimatedIcon">@drawable/atlas_mark</item>
  <item name="postSplashScreenTheme">@style/Theme.Atlas</item>
 </style>
</resources>
